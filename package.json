{
  "name": "hanviet-dict",
  "version": "1.0.0",
  "private": true,
  "description": "漢喃詞典 — 中越雙向詞典與 AI 翻譯",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "python -m http.server 5173 --directory app",
    "dist:win": "electron-builder --win nsis",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.16.0"
  },
  "build": {
    "appId": "org.chunom.hanvietdict",
    "productName": "漢喃詞典",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HanVietDict-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}